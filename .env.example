TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
OPENAI_API_KEY=your-openai-api-key-here
DATABASE_URL=sqlite:///./data/calories.db

# Open Food Facts fallback (no API key; disable with false if you want fully offline parsing)
OPEN_FOOD_FACTS_ENABLED=true
# Shown in User-Agent — use your site or GitHub profile per OFF API etiquette
OFF_CONTACT_URL=https://github.com/
OFF_REQUEST_TIMEOUT_SEC=8
